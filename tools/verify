#!/usr/bin/env python3

from __future__ import annotations

import os
from pathlib import Path
import re
import shutil
import subprocess
import sys
import tempfile


REPO_ROOT = Path(__file__).resolve().parent.parent


def run(
    command: list[str],
    *,
    cwd: Path = REPO_ROOT,
    environment: dict[str, str] | None = None,
) -> str:
    result = subprocess.run(
        command,
        cwd=cwd,
        env=environment,
        text=True,
        stdout=subprocess.PIPE,
        stderr=subprocess.STDOUT,
    )
    if result.returncode:
        raise RuntimeError(
            f"command failed ({result.returncode}): {' '.join(command)}\n"
            f"{result.stdout.strip()}"
        )
    return result.stdout


def read_package_list(path: Path) -> list[str]:
    lines = path.read_text().splitlines()
    declarations = [
        index for index, line in enumerate(lines) if line.startswith("AIQ_PACKAGES")
    ]
    relative_path = path.relative_to(REPO_ROOT)
    if len(declarations) != 1 or lines[declarations[0]] != "AIQ_PACKAGES := \\":
        raise RuntimeError(
            f"{relative_path} must contain one canonical AIQ_PACKAGES list"
        )
    start = declarations[0]
    package_lines: list[str] = []
    for line in lines[start + 1 :]:
        if not line.startswith("  "):
            break
        package_lines.append(line)
    if not package_lines:
        raise RuntimeError(f"{relative_path}: AIQ_PACKAGES must not be empty")
    packages: list[str] = []
    for index, line in enumerate(package_lines):
        suffix = r" \\" if index < len(package_lines) - 1 else ""
        match = re.fullmatch(r"  ([a-z0-9][a-z0-9@._+-]*)" + suffix, line)
        if not match:
            raise RuntimeError(
                f"{relative_path}: list each package on its own line"
            )
        packages.append(match.group(1))
    if packages != sorted(set(packages)):
        raise RuntimeError(f"{relative_path}: packages must be sorted and unique")
    return packages


def check_platform_packages() -> None:
    makefile_lines = (REPO_ROOT / "Makefile").read_text().splitlines()
    if makefile_lines.count("include make/platform.mk") != 1:
        raise RuntimeError("Makefile must include make/platform.mk exactly once")
    makefile = "\n".join(makefile_lines)
    forbidden_root_policy = ("AIQ_PACKAGES", "brew install", "pacman -S")
    offenders = [value for value in forbidden_root_policy if value in makefile]
    if offenders:
        raise RuntimeError(
            f"Makefile contains platform-specific policy: {', '.join(offenders)}"
        )

    platform_directory = REPO_ROOT / "make" / "platforms"
    expected_fragments = {
        "arch": "pacman",
        "macos": "brew",
    }
    for platform, installer in expected_fragments.items():
        fragment = platform_directory / f"{platform}.mk"
        read_package_list(fragment)
        output = run(
            [
                "make",
                "--no-print-directory",
                "--dry-run",
                "install-packages",
                f"AIQ_PLATFORM={platform}",
            ]
        )
        if installer not in output:
            raise RuntimeError(
                f"{fragment.relative_to(REPO_ROOT)} does not select {installer}"
            )

    unsupported_platform = "not-a-platform"
    unsupported_fragment = platform_directory / f"{unsupported_platform}.mk"
    if unsupported_fragment.exists():
        raise RuntimeError(
            f"reserved test platform exists: {unsupported_fragment.relative_to(REPO_ROOT)}"
        )
    unsupported_command = [
        "make",
        "--no-print-directory",
        "install-packages",
        f"AIQ_PLATFORM={unsupported_platform}",
    ]
    unsupported = run(
        [*unsupported_command[:2], "--dry-run", *unsupported_command[2:]]
    )
    if "Unsupported" not in unsupported or "AIQ_PLATFORM" not in unsupported:
        raise RuntimeError(
            "unsupported platform must report the platform and AIQ_PLATFORM override"
        )
    forbidden_commands = ("brew ", "pacman ", "sudo ")
    selected_installers = [
        command for command in forbidden_commands if command in unsupported
    ]
    if selected_installers:
        raise RuntimeError(
            "unsupported platform selected a package manager: "
            f"{', '.join(selected_installers)}"
        )
    traversal = run(
        [
            "make",
            "--no-print-directory",
            "--dry-run",
            "install-packages",
            "AIQ_PLATFORM=../platform",
        ]
    )
    if "Unsupported" not in traversal or any(
        command in traversal for command in forbidden_commands
    ):
        raise RuntimeError("AIQ_PLATFORM must select only whitelisted platforms")
    result = subprocess.run(
        unsupported_command,
        cwd=REPO_ROOT,
        text=True,
        stdout=subprocess.PIPE,
        stderr=subprocess.STDOUT,
    )
    if result.returncode != 2:
        raise RuntimeError(
            "unsupported platform must exit 2; "
            f"found {result.returncode}: {result.stdout.strip()}"
        )
    if "Unsupported" not in result.stdout or "AIQ_PLATFORM" not in result.stdout:
        raise RuntimeError(
            "unsupported platform execution must report the platform and "
            "AIQ_PLATFORM override"
        )


def check_tool_syntax() -> None:
    for path in sorted((REPO_ROOT / "tools").iterdir()):
        if not path.is_file() or path.suffix:
            continue
        content = path.read_bytes()
        if not content:
            raise RuntimeError(f"{path.relative_to(REPO_ROOT)} is empty")
        first_line = content.splitlines()[0].decode("utf-8", errors="replace")
        if first_line == "#!/bin/sh":
            run(["/bin/sh", "-n", str(path)])
        elif first_line == "#!/usr/bin/env python3":
            try:
                compile(content, str(path.relative_to(REPO_ROOT)), "exec")
            except (SyntaxError, UnicodeError) as error:
                raise RuntimeError(
                    f"{path.relative_to(REPO_ROOT)}: {error}"
                ) from error
        else:
            raise RuntimeError(f"{path.relative_to(REPO_ROOT)} has no known shebang")


def check_bootstrap() -> None:
    source = (REPO_ROOT / "AGENTS.md").read_bytes()
    packaged = (REPO_ROOT / "src/aiq/_resources/AGENTS.md").read_bytes()
    if source != packaged:
        raise RuntimeError("packaged AGENTS.md differs from the canonical file")
    words = len(source.decode().split())
    if words > 200:
        raise RuntimeError(f"AGENTS.md has {words} words; maximum is 200")


def check_public_paths() -> None:
    forbidden_suffixes = (".db", ".sqlite", ".sqlite3", ".pyc")
    tracked = run(["git", "ls-files", "-z"]).split("\0")
    offenders = [
        path
        for path in tracked
        if path.endswith(forbidden_suffixes)
        or "__pycache__/" in path
        or path.startswith((".aiq/", ".journal/", "dist/", "build/"))
    ]
    if offenders:
        raise RuntimeError(f"private/generated paths are tracked: {offenders}")


def check_python() -> None:
    for root in ("src", "tests", "tools"):
        for path in sorted((REPO_ROOT / root).rglob("*.py")):
            try:
                compile(path.read_bytes(), str(path.relative_to(REPO_ROOT)), "exec")
            except (SyntaxError, UnicodeError) as error:
                raise RuntimeError(f"{path.relative_to(REPO_ROOT)}: {error}") from error

    environment = os.environ.copy()
    environment["PYTHONDONTWRITEBYTECODE"] = "1"
    source_path = str(REPO_ROOT / "src")
    existing_path = environment.get("PYTHONPATH")
    environment["PYTHONPATH"] = (
        f"{source_path}{os.pathsep}{existing_path}" if existing_path else source_path
    )
    run(
        [sys.executable, "-m", "unittest", "discover", "-s", "tests"],
        environment=environment,
    )


def check_build() -> None:
    environment = os.environ.copy()
    environment["PYTHONDONTWRITEBYTECODE"] = "1"
    with tempfile.TemporaryDirectory(prefix="aiq-build-") as directory:
        temporary_root = Path(directory)
        checkout = temporary_root / "checkout"
        checkout.mkdir()
        for name in ("LICENSE", "MANIFEST.in", "README.md", "pyproject.toml"):
            shutil.copyfile(REPO_ROOT / name, checkout / name)
        shutil.copytree(
            REPO_ROOT / "src",
            checkout / "src",
            ignore=shutil.ignore_patterns("__pycache__", "*.egg-info", "*.pyc"),
        )
        output = temporary_root / "dist"
        run(
            [
                "pyproject-build",
                "--no-isolation",
                "--outdir",
                str(output),
            ],
            cwd=checkout,
            environment=environment,
        )
        distributions = sorted(
            path.name for path in output.iterdir() if path.is_file()
        )
    wheels = [name for name in distributions if name.endswith(".whl")]
    source_distributions = [
        name for name in distributions if name.endswith(".tar.gz")
    ]
    if len(wheels) != 1 or len(source_distributions) != 1:
        raise RuntimeError(
            "build must produce exactly one wheel and one source distribution; "
            f"found {distributions}"
        )


def check_sanity() -> None:
    run([str(REPO_ROOT / "tools" / "sanity-check")])


def main() -> int:
    try:
        check_sanity()
    except (OSError, RuntimeError) as error:
        print(f"FAIL check_sanity: {error}")
        return 1
    checks = (
        check_platform_packages,
        check_tool_syntax,
        check_bootstrap,
        check_public_paths,
        check_python,
        check_build,
    )
    failures: list[str] = []
    for check in checks:
        try:
            check()
        except (OSError, RuntimeError, ValueError) as error:
            failures.append(f"{check.__name__}: {error}")
    if failures:
        for failure in failures:
            print(f"FAIL {failure}")
        return 1
    print("Verification passed.")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
